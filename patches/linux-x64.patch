--- /dev/null
+++ b/apps/desktop-host/src/runtime-layout.ts
@@ -0,0 +1,15 @@
+/** Locate the directory that carries the Desktop runtime payload, in every layout the app ships. */
+
+import { basename, dirname } from 'node:path'
+
+/**
+ * Resolve the directory whose `runtime/` child holds interpreters, pnpm and the primary runtime.
+ * A packaged dsh sits inside `app.asar`, or unpacked beside it on Linux; a prepared dsh sits directly in its target directory.
+ * @param runtimeDir - Prepared, ASAR-contained, or unpacked dsh directory.
+ * @returns Directory that carries the runtime payload.
+ */
+export function desktopSupportDirectory(runtimeDir: string): string {
+  const parent = dirname(runtimeDir)
+  const name = basename(parent)
+  return name === 'app.asar' || name === 'app.asar.unpacked' ? dirname(parent) : parent
+}
